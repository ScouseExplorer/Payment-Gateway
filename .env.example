# Database Configuration
DB_USER=paymentuser
DB_PASSWORD=changeme
DB_NAME=payment_core
DB_HOST=localhost
DB_PORT=5432

# Spring Configuration
SPRING_PROFILE=dev
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=payment-core-service
KAFKA_TOPIC_PAYMENTS=payment.events
KAFKA_TOPIC_SETTLEMENTS=settlement.events

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Keys
API_KEY=your-api-key-here
MERCHANT_API_KEY=merchant-api-key-here

# External Service Endpoints
VISA_API_URL=https://api.visa.example.com
MASTERCARD_API_URL=https://api.mastercard.example.com
PAYPAL_API_URL=https://api.paypal.example.com
BANK_API_URL=https://api.bank.example.com
LEDGER_API_URL=https://api.ledger.example.com

# Fraud Detection
FRAUD_SERVICE_URL=https://fraud-service.example.com
FRAUD_SERVICE_API_KEY=fraud-service-key

# Notification Service
NOTIFICATION_SERVICE_URL=https://notification.example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Monitoring & Logging
LOG_LEVEL=INFO
LOGBACK_CONFIG=classpath:logback-spring.xml
METRICS_EXPORT_PROMETHEUS_ENABLED=true

# Security
ENCRYPTION_KEY=your-encryption-key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true

# Application Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
ACTUATOR_ENDPOINTS_ENABLED=true

# Transaction Processing
PAYMENT_TIMEOUT_SECONDS=30
REFUND_TIMEOUT_SECONDS=60
SETTLEMENT_BATCH_SIZE=1000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Feature Flags
FEATURE_FRAUD_CHECK_ENABLED=true
FEATURE_3D_SECURE_ENABLED=true
FEATURE_TOKENIZATION_ENABLED=true
